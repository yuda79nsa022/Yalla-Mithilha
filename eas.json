{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_CATALOGUE_API_URL": "https://REPLACE-WITH-LIVE-SERVER"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_CATALOGUE_API_URL": "https://REPLACE-WITH-LIVE-SERVER"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "223GH9GP28",
        "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID"
      }
    }
  }
}
