# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Long, random, unique per environment. Signs admin login sessions (JWT).
# Required — the server refuses any /admin/* route without it.
SESSION_SECRET=

# Long, random, unique per environment, and DIFFERENT from SESSION_SECRET —
# a player session token must never be able to verify as an admin session.
# Required — the server refuses /players/* and any player-only route without it.
PLAYER_SESSION_SECRET=

# Where the SQLite file and uploaded images live.
DATA_DIR=./data

# Override the exact SQLite file path. Tests set this to an isolated temp
# path automatically — you don't need to set it yourself for local dev.
# DB_PATH=./data/catalogue.sqlite

# Payment gateway. Unset (or anything but "myfatoorah") uses the development
# MOCK provider, where any player can confirm their own payment for free —
# never run production on the mock.
# PAYMENT_PROVIDER=myfatoorah

# With NODE_ENV=production the mock refuses every checkout, so no game can be
# played without a real MyFatoorah payment. Set this only on a test server
# that should keep the free mock anyway.
# ALLOW_MOCK_PAYMENTS=true

# MyFatoorah API token (portal: Integration Settings → API Key). Secret —
# server-side only, never in the app.
# MYFATOORAH_API_KEY=

# https://apitest.myfatoorah.com for the sandbox (the default), or
# https://api.myfatoorah.com for live payments in Kuwait.
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# This server's public https address, as players reach it through nginx.
# MyFatoorah sends players back to $PUBLIC_BASE_URL/charades/checkout/myfatoorah/return.
# PUBLIC_BASE_URL=https://your-domain.example

# Email (the "running low on games" notice). Unset logs emails to the
# console instead — development only. Resend is called over HTTPS; no SDK.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Bas Bedoon Kalam <games@your-domain.example>
