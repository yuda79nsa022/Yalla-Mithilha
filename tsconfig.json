{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/**/*", "app/**/*", "__tests__/**/*"],
  "exclude": ["node_modules"]
}
