{
  "expo": {
    "name": "Yalla Mithilha",
    "slug": "yalla-mithilha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yallamithilha",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F0DF",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#F7F0DF",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.yallamithilha",
      "infoPlist": {
        "UIRequiresPersistentWiFi": false
      }
    },
    "android": {
      "package": "com.example.yallamithilha",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#246E9C"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-localization"],
    "extra": {
      "note": "No camera, microphone, contacts or network permissions are requested."
    }
  }
}
