{
  "expo": {
    "name": "Bas Bedoon Kalam",
    "slug": "bas-bedoon-kalam",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "basbedoonkalam",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F2F2",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#F3F2F2",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basbedoonkalam.app",
      "infoPlist": {
        "UIRequiresPersistentWiFi": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.basbedoonkalam.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#8038D1"
      },
      "permissions": [],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "Bas Bedoon Kalam",
      "shortName": "Bas Bedoon Kalam",
      "themeColor": "#8038D1",
      "backgroundColor": "#F3F2F2"
    },
    "plugins": ["expo-router", "expo-localization"],
    "extra": {
      "note": "No camera, microphone, contacts or network permissions are requested.",
      "eas": {
        "projectId": "eb7a6e1d-6845-4dd9-b0c8-cbfb0bc08ddf"
      }
    },
    "owner": "drdds2005"
  }
}
